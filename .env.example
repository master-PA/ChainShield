# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Ethereum Sepolia Blockchain Evidence Anchoring Configuration
# ---------------------------------------------------------------------------

# VITE_SEPOLIA_RPC_URL: RPC endpoint for querying Ethereum Sepolia testnet.
VITE_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# VITE_EVIDENCE_REGISTRY_ADDRESS: The deployed EvidenceRegistry contract address on Sepolia.
# Leave empty if contract is not yet deployed; the UI will gracefully show unconfigured status.
VITE_EVIDENCE_REGISTRY_ADDRESS=""

# VITE_SEPOLIA_DEMO_CONTRACT_ADDRESS: (Optional) The deployed ChainShieldUnsafeMintDemo address on Sepolia.
# Allows 1-click preset filling in the Smart Contract Scanner tab.
VITE_SEPOLIA_DEMO_CONTRACT_ADDRESS=""

# ---------------------------------------------------------------------------
# BACKEND CONTRACT SCANNER CONFIGURATION (Server-Side Only - NEVER prefix with VITE_)
# Put these in .env.local
# ---------------------------------------------------------------------------

# ETHERSCAN_API_KEY: Etherscan API V2 key for verified contract source retrieval.
# Used exclusively on the backend to avoid exposing credentials to browser bundles.
# If omitted, ChainShield automatically uses public Sourcify source verification.
ETHERSCAN_API_KEY=""

# Dedicated RPC URLs (Fallback to public high-availability nodes if omitted)
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
MAINNET_RPC_URL="https://ethereum-rpc.publicnode.com"

# SEPOLIA_DEMO_CONTRACT_ADDRESS: (Optional) Address of ChainShieldUnsafeMintDemo for backend fixture resolution.
SEPOLIA_DEMO_CONTRACT_ADDRESS=""

# ---------------------------------------------------------------------------
# LOCAL DEPLOYMENT ONLY (NEVER commit secrets to git)
# Put these in .env.local for running `npm run deploy:registry` or `npm run deploy:demo`
# ---------------------------------------------------------------------------
# DEPLOYER_PRIVATE_KEY=""
