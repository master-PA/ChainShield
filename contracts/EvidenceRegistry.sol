pragma solidity ^0.8.20;

/**
 * @title EvidenceRegistry
 * @dev Immutable public registry for storing and verifying SHA-256 canonical evidence hashes
 * generated by ChainShield Sentinel pre-transaction security scans.
 */
contract EvidenceRegistry {
    struct Evidence {
        bytes32 evidenceHash;
        uint256 timestamp;
        address submitter;
        uint256 blockNumber;
    }

    // Mapping from unique reportId to Evidence record
    mapping(string => Evidence) private _registry;

    // Emitted whenever an evidence hash is registered
    event EvidenceAnchored(
        string indexed reportIdIndexed,
        string reportId,
        bytes32 indexed evidenceHash,
        address indexed submitter,
        uint256 timestamp,
        uint256 blockNumber
    );

    // Custom errors for gas efficiency and clear reverts
    error EmptyReportId();
    error InvalidEvidenceHash();
    error EvidenceAlreadyRegistered(string reportId, bytes32 existingHash);

    /**
     * @notice Anchors a cryptographic evidence hash on Ethereum Sepolia.
     * @param reportId Unique identifier for the scan report (e.g. REP-SEPOLIA-...).
     * @param evidenceHash Canonical SHA-256 evidence hash (bytes32).
     */
    function anchorEvidence(string calldata reportId, bytes32 evidenceHash) external {
        if (bytes(reportId).length == 0) {
            revert EmptyReportId();
        }
        if (evidenceHash == bytes32(0)) {
            revert InvalidEvidenceHash();
        }
        if (_registry[reportId].evidenceHash != bytes32(0)) {
            revert EvidenceAlreadyRegistered(reportId, _registry[reportId].evidenceHash);
        }

        _registry[reportId] = Evidence({
            evidenceHash: evidenceHash,
            timestamp: block.timestamp,
            submitter: msg.sender,
            blockNumber: block.number
        });

        emit EvidenceAnchored(
            reportId,
            reportId,
            evidenceHash,
            msg.sender,
            block.timestamp,
            block.number
        );
    }

    /**
     * @notice Queries the stored evidence for a given report ID.
     * @param reportId The report ID to query.
     * @return evidenceHash Registered SHA-256 hash (bytes32(0) if unanchored).
     * @return timestamp Block timestamp when anchored.
     * @return submitter Wallet address that submitted the evidence.
     * @return blockNumber Ethereum block number where anchored.
     */
    function getEvidence(string calldata reportId)
        external
        view
        returns (
            bytes32 evidenceHash,
            uint256 timestamp,
            address submitter,
            uint256 blockNumber
        )
    {
        Evidence memory record = _registry[reportId];
        return (
            record.evidenceHash,
            record.timestamp,
            record.submitter,
            record.blockNumber
        );
    }

    /**
     * @notice Verifies whether a given SHA-256 hash matches the on-chain anchor for reportId.
     * @param reportId The report ID to verify.
     * @param expectedHash The expected SHA-256 hash to test.
     * @return isMatch True if the report is anchored and the hash exactly matches.
     */
    function verifyEvidence(string calldata reportId, bytes32 expectedHash)
        external
        view
        returns (bool isMatch)
    {
        bytes32 storedHash = _registry[reportId].evidenceHash;
        return storedHash != bytes32(0) && storedHash == expectedHash;
    }
}
